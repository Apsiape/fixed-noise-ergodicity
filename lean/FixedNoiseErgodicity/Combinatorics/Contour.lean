/-
# Toom's contour lemma on an abstract support system (`lem:contour`, Steps 1–4)

The paper (Section 3.4, `lem:contour`) works in the graph `𝒢`. Here we prove the combinatorial
core on an abstract *support system*: vertices with a time; some vertices are *non-terminal*
(`NF`), and each non-terminal `θ` has two supports `sup θ true`, `sup θ false` one step lower,
reached through two different *providers* (`prov`); the charges are the providers, a finite type
`C` with `q = |C|`. Potentials `ψ_c` sum to zero at every vertex and change by `+1` along a support
edge through a provider `≠ c` and by `1 - q = -k` along one through `c` (`fgt:eq-sum`,
`fgt:eq-incr`). The concrete instance is built in `Section3/Contour.lean`.

Faithful to the printed proof: supports (Step 1), terminal sets `Φ(θ)` (`Term`), greedy arms for
each charge, poles with first steps (Step 2), the splitting of fronts with the invariant `(I_h)`
(Step 3), the component of the root pole and the potential count (Step 4).

**[choice]** Two reorganizations of Step 3, with the same content.
* The components of the front `W_h` enter `(I_h)` only through their terminal sets `Φ(𝒦)`, which
  partition `Φ`. We use the equivalence on terminals generated by "both lie in `Φ(θ)` for one
  `θ ∈ W`" (`Rel W`); its classes are exactly the sets `Φ(𝒦)`, and `(I_h)` reads: for every
  terminal `φ` and charge `c`, exactly one pole has its `c`-arm ending `Rel W`-equivalent to `φ`.
* Instead of listing the non-terminals by time, any non-terminal of the front is split; the
  process stops because `Σ_{θ ∈ W} 3^{time θ}` decreases. A vertex met twice may get two poles;
  the potential count does not care.
The bound `t_ρ - s ≤ |K|` of (iii) is proved by counting, for each time level crossed between `ρ`
and a sink, one edge of `K` crossing it (instead of a shortest path in `H_ρ`).
-/
import Mathlib.Logic.Relation
import Mathlib.Data.Finset.Card
import Mathlib.Data.Fintype.BigOperators
import Mathlib.Algebra.BigOperators.Ring.Finset
import Mathlib.Order.Interval.Finset.Nat
import Mathlib.Tactic.Linarith
import Mathlib.Tactic.Ring
import FixedNoiseErgodicity.Combinatorics.EdgeCount

set_option autoImplicit false
set_option linter.unusedSectionVars false

noncomputable section

namespace FNE.Contour

open Relation

/-- A support system (Step 1 of the proof of `lem:contour`, abstracted). -/
structure SupportSystem (V C : Type*) where
  /-- the time of a vertex -/
  time : V → ℕ
  /-- non-terminal vertices (in the paper: vertices of `𝒰 \ 𝒰_f`) -/
  NF : V → Prop
  /-- the two supports of a non-terminal vertex -/
  sup : V → Bool → V
  /-- the providers through which the supports are lower neighbours -/
  prov : V → Bool → C
  prov_ne : ∀ θ, NF θ → prov θ true ≠ prov θ false
  time_sup : ∀ θ b, NF θ → time (sup θ b) + 1 = time θ

namespace SupportSystem

variable {V C : Type*} (S : SupportSystem V C)

/-- A step from a non-terminal vertex to one of its supports. -/
def Step (a b : V) : Prop := S.NF a ∧ ∃ bb, b = S.sup a bb

/-- `b` is reached from `a` by following supports. -/
def Reach (a b : V) : Prop := ReflTransGen S.Step a b

/-- `φ ∈ Φ(θ)`: `φ` is a terminal reached from `θ`. -/
def Term (θ φ : V) : Prop := S.Reach θ φ ∧ ¬ S.NF φ

/-- Induction along supports (times decrease). -/
theorem time_induction {P : V → Prop} (h : ∀ θ, (S.NF θ → ∀ b, P (S.sup θ b)) → P θ) (θ : V) :
    P θ := by
  suffices ∀ n θ, S.time θ = n → P θ from this _ θ rfl
  intro n
  induction n with
  | zero =>
    intro θ hθ
    exact h θ (fun hnf b => absurd (S.time_sup θ b hnf) (by omega))
  | succ n ih =>
    intro θ hθ
    exact h θ (fun hnf b => ih _ (by have := S.time_sup θ b hnf; omega))

theorem time_le_of_reach {a b : V} (h : S.Reach a b) : S.time b ≤ S.time a := by
  induction h with
  | refl => exact le_rfl
  | tail _ hst ih =>
    obtain ⟨hnf, bb, rfl⟩ := hst
    have := S.time_sup _ bb hnf
    omega

theorem eq_of_reach_of_not_NF {a b : V} (ha : ¬ S.NF a) (h : S.Reach a b) : b = a := by
  rcases ReflTransGen.cases_head h with h | ⟨c, hac, _⟩
  · exact h.symm
  · exact absurd hac.1 ha

theorem reach_sup {θ : V} (h : S.NF θ) (b : Bool) : S.Reach θ (S.sup θ b) :=
  ReflTransGen.single ⟨h, b, rfl⟩

theorem term_trans {a θ φ : V} (h : S.Reach a θ) (h' : S.Term θ φ) : S.Term a φ :=
  ⟨h.trans h'.1, h'.2⟩

theorem term_of_sup {θ φ : V} (h : S.NF θ) {b : Bool} (h' : S.Term (S.sup θ b) φ) :
    S.Term θ φ :=
  S.term_trans (S.reach_sup h b) h'

/-- `fgt:eq-Phi`: `Φ(θ) = Φ(θ⁽¹⁾) ∪ Φ(θ⁽²⁾)` for a non-terminal `θ`. -/
theorem term_sup_iff {θ a : V} (h : S.NF θ) :
    S.Term θ a ↔ S.Term (S.sup θ true) a ∨ S.Term (S.sup θ false) a := by
  constructor
  · rintro ⟨hr, hn⟩
    rcases ReflTransGen.cases_head hr with rfl | ⟨c, ⟨_, bb, rfl⟩, hc⟩
    · exact absurd h hn
    · cases bb
      · exact Or.inr ⟨hc, hn⟩
      · exact Or.inl ⟨hc, hn⟩
  · rintro (h' | h')
    · exact S.term_of_sup h h'
    · exact S.term_of_sup h h'

/-! ## Greedy arms (Step 2) -/

variable [DecidableEq C]

/-- The support of `θ` that is reached by an edge good for charge `c` (its provider is `≠ c`). -/
def gb (c : C) (θ : V) : Bool := decide (S.prov θ true ≠ c)

/-- `g_c(θ)`. -/
def g (c : C) (θ : V) : V := S.sup θ (S.gb c θ)

theorem prov_gb (c : C) {θ : V} (h : S.NF θ) : S.prov θ (S.gb c θ) ≠ c := by
  unfold gb
  by_cases hc : S.prov θ true = c
  · have h1 : decide (S.prov θ true ≠ c) = false := by simp [hc]
    rw [h1, ← hc]
    exact (S.prov_ne θ h).symm
  · have h1 : decide (S.prov θ true ≠ c) = true := by simp [hc]
    rw [h1]
    exact hc

theorem time_g (c : C) {θ : V} (h : S.NF θ) : S.time θ = S.time (S.g c θ) + 1 :=
  (S.time_sup θ _ h).symm

open Classical in
/-- The end of the greedy `c`-path, with fuel. -/
def gEndF (c : C) : ℕ → V → V
  | 0, θ => θ
  | n + 1, θ => if S.NF θ then gEndF c n (S.g c θ) else θ

open Classical in
/-- The number of edges of the greedy `c`-path, with fuel. -/
def gLenF (c : C) : ℕ → V → ℕ
  | 0, _ => 0
  | n + 1, θ => if S.NF θ then gLenF c n (S.g c θ) + 1 else 0

/-- The end of the greedy `c`-path from `θ`: follow `g_c` until a terminal. -/
def gEnd (c : C) (θ : V) : V := S.gEndF c (S.time θ) θ

/-- The number of edges of the greedy `c`-path from `θ`. -/
def gLen (c : C) (θ : V) : ℕ := S.gLenF c (S.time θ) θ

theorem gEnd_of_NF (c : C) {θ : V} (h : S.NF θ) : S.gEnd c θ = S.gEnd c (S.g c θ) := by
  unfold gEnd
  rw [S.time_g c h, gEndF, if_pos h]

theorem gEnd_of_not (c : C) {θ : V} (h : ¬ S.NF θ) : S.gEnd c θ = θ := by
  unfold gEnd
  cases S.time θ with
  | zero => rfl
  | succ n => rw [gEndF, if_neg h]

theorem gLen_of_NF (c : C) {θ : V} (h : S.NF θ) : S.gLen c θ = S.gLen c (S.g c θ) + 1 := by
  unfold gLen
  rw [S.time_g c h, gLenF, if_pos h]

theorem gLen_of_not (c : C) {θ : V} (h : ¬ S.NF θ) : S.gLen c θ = 0 := by
  unfold gLen
  cases S.time θ with
  | zero => rfl
  | succ n => rw [gLenF, if_neg h]

theorem gEnd_term (c : C) : ∀ θ : V, S.Term θ (S.gEnd c θ) := by
  refine S.time_induction (fun θ ih => ?_)
  by_cases h : S.NF θ
  · rw [S.gEnd_of_NF c h]
    exact S.term_of_sup h (ih h (S.gb c θ))
  · rw [S.gEnd_of_not c h]
    exact ⟨ReflTransGen.refl, h⟩

/-- Every terminal set is nonempty. -/
theorem exists_term (θ : V) : ∃ φ, S.Term θ φ := by
  by_cases h : S.NF θ
  · exact ⟨_, S.gEnd_term (S.prov θ true) θ⟩
  · exact ⟨θ, ReflTransGen.refl, h⟩

section Edges

variable [DecidableEq V]

open Classical in
/-- The edges of the greedy `c`-path, with fuel. -/
def gEdgesF (c : C) : ℕ → V → Finset (Sym2 V)
  | 0, _ => ∅
  | n + 1, θ => if S.NF θ then insert s(θ, S.g c θ) (gEdgesF c n (S.g c θ)) else ∅

/-- The edges of the greedy `c`-path from `θ`. -/
def gEdges (c : C) (θ : V) : Finset (Sym2 V) := S.gEdgesF c (S.time θ) θ

theorem gEdges_of_NF (c : C) {θ : V} (h : S.NF θ) :
    S.gEdges c θ = insert s(θ, S.g c θ) (S.gEdges c (S.g c θ)) := by
  unfold gEdges
  rw [S.time_g c h, gEdgesF, if_pos h]

theorem gEdges_of_not (c : C) {θ : V} (h : ¬ S.NF θ) : S.gEdges c θ = ∅ := by
  unfold gEdges
  cases S.time θ with
  | zero => rfl
  | succ n => rw [gEdgesF, if_neg h]

theorem gEdges_card_le (c : C) : ∀ θ : V, (S.gEdges c θ).card ≤ S.gLen c θ := by
  refine S.time_induction (fun θ ih => ?_)
  by_cases h : S.NF θ
  · rw [S.gEdges_of_NF c h, S.gLen_of_NF c h]
    exact (Finset.card_insert_le _ _).trans (Nat.add_le_add_right (ih h (S.gb c θ)) 1)
  · rw [S.gEdges_of_not c h]
    simp

theorem gEdges_spec (c : C) : ∀ θ : V, ∀ e ∈ S.gEdges c θ,
    ∃ a b, S.Reach θ a ∧ S.NF a ∧ e = s(a, S.sup a b) := by
  refine S.time_induction (fun θ ih => ?_)
  intro e he
  by_cases h : S.NF θ
  · rw [S.gEdges_of_NF c h, Finset.mem_insert] at he
    rcases he with rfl | he
    · exact ⟨θ, S.gb c θ, ReflTransGen.refl, h, rfl⟩
    · obtain ⟨a, b, ha, hna, rfl⟩ := ih h (S.gb c θ) e he
      exact ⟨a, b, (S.reach_sup h _).trans ha, hna, rfl⟩
  · rw [S.gEdges_of_not c h] at he
    simp at he

theorem reach_mono {K K' : Finset (Sym2 V)} (h : K ⊆ K') {a b : V} (hr : EdgeCount.Reach K a b) :
    EdgeCount.Reach K' a b :=
  ReflTransGen.mono (fun _ _ hx => h hx) _ _ hr

theorem reach_symm {K : Finset (Sym2 V)} {a b : V} (hr : EdgeCount.Reach K a b) :
    EdgeCount.Reach K b a :=
  by
    letI : Std.Symm (fun x y : V => s(x, y) ∈ K) :=
      ⟨fun x y hxy => by rwa [Sym2.eq_swap]⟩
    exact (ReflTransGen.stdSymm (r := fun x y : V => s(x, y) ∈ K)).symm _ _ hr

/-- The greedy path is connected from its start, and reaches its end. -/
theorem gEdges_reach (c : C) : ∀ θ : V,
    (∀ e ∈ S.gEdges c θ, ∀ v ∈ e, EdgeCount.Reach (S.gEdges c θ) θ v) ∧
      EdgeCount.Reach (S.gEdges c θ) θ (S.gEnd c θ) := by
  refine S.time_induction (fun θ ih => ?_)
  by_cases h : S.NF θ
  · obtain ⟨ih1, ih2⟩ := ih h (S.gb c θ)
    rw [S.gEnd_of_NF c h, S.gEdges_of_NF c h]
    have hsub : S.gEdges c (S.g c θ) ⊆ insert s(θ, S.g c θ) (S.gEdges c (S.g c θ)) :=
      Finset.subset_insert _ _
    have hstep : EdgeCount.Reach (insert s(θ, S.g c θ) (S.gEdges c (S.g c θ))) θ (S.g c θ) :=
      ReflTransGen.single (Finset.mem_insert_self _ _)
    refine ⟨fun e he v hv => ?_, hstep.trans (reach_mono hsub ih2)⟩
    rcases Finset.mem_insert.mp he with rfl | he
    · rcases Sym2.mem_iff.mp hv with rfl | rfl
      · exact ReflTransGen.refl
      · exact hstep
    · exact hstep.trans (reach_mono hsub (ih1 e he v hv))
  · rw [S.gEnd_of_not c h, S.gEdges_of_not c h]
    exact ⟨fun e he => by simp at he, ReflTransGen.refl⟩

/-- Every vertex on the greedy path is its end or continues along it. -/
theorem gEdges_down (c : C) : ∀ θ : V, ∀ v, (v = θ ∨ ∃ e ∈ S.gEdges c θ, v ∈ e) →
    v = S.gEnd c θ ∨ (S.NF v ∧ s(v, S.g c v) ∈ S.gEdges c θ) := by
  refine S.time_induction (fun θ ih => ?_)
  intro v hv
  by_cases h : S.NF θ
  · rw [S.gEnd_of_NF c h, S.gEdges_of_NF c h]
    have hsub : S.gEdges c (S.g c θ) ⊆ insert s(θ, S.g c θ) (S.gEdges c (S.g c θ)) :=
      Finset.subset_insert _ _
    have hrec : (v = S.g c θ ∨ ∃ e ∈ S.gEdges c (S.g c θ), v ∈ e) →
        v = S.gEnd c (S.g c θ) ∨
          (S.NF v ∧ s(v, S.g c v) ∈ insert s(θ, S.g c θ) (S.gEdges c (S.g c θ))) := by
      intro hv'
      rcases ih h (S.gb c θ) v hv' with h1 | ⟨h1, h2⟩
      · exact Or.inl h1
      · exact Or.inr ⟨h1, hsub h2⟩
    rcases hv with rfl | ⟨e, he, hve⟩
    · exact Or.inr ⟨h, Finset.mem_insert_self _ _⟩
    · rw [S.gEdges_of_NF c h, Finset.mem_insert] at he
      rcases he with rfl | he
      · rcases Sym2.mem_iff.mp hve with rfl | rfl
        · exact Or.inr ⟨h, Finset.mem_insert_self _ _⟩
        · exact hrec (Or.inl rfl)
      · exact hrec (Or.inr ⟨e, he, hve⟩)
  · rw [S.gEdges_of_not c h] at hv ⊢
    rw [S.gEnd_of_not c h]
    rcases hv with rfl | ⟨e, he, -⟩
    · exact Or.inl rfl
    · simp at he

/-- The end of the greedy path is its start or lies on one of its edges. -/
theorem gEnd_mem (c : C) : ∀ θ : V, S.gEnd c θ = θ ∨ ∃ e ∈ S.gEdges c θ, S.gEnd c θ ∈ e := by
  refine S.time_induction (fun θ ih => ?_)
  by_cases h : S.NF θ
  · rw [S.gEnd_of_NF c h, S.gEdges_of_NF c h]
    rcases ih h (S.gb c θ) with h1 | ⟨e, he, hm⟩
    · refine Or.inr ⟨_, Finset.mem_insert_self _ _, ?_⟩
      rw [show S.gEnd c (S.g c θ) = S.g c θ from h1]
      exact Sym2.mem_mk_right _ _
    · exact Or.inr ⟨e, Finset.mem_insert_of_mem he, hm⟩
  · exact Or.inl (S.gEnd_of_not c h)

end Edges

/-! ## Potentials -/

variable [Fintype C]

/-- `fgt:eq-sum` and `fgt:eq-incr`: the potentials sum to zero, and a support edge raises `ψ_c` by
`1` if its provider is not `c`, and changes it by `1 - q = -k` otherwise. -/
def IsPotential (ψ : C → V → ℤ) : Prop :=
  (∀ θ, ∑ c, ψ c θ = 0) ∧
    ∀ θ b c, S.NF θ →
      ψ c (S.sup θ b) = ψ c θ + 1 - (if S.prov θ b = c then (Fintype.card C : ℤ) else 0)

/-- Along a greedy `c`-path every edge is good for `c`: `ψ_c` rises by the number of edges. -/
theorem gEnd_psi {ψ : C → V → ℤ} (hψ : S.IsPotential ψ) (c : C) :
    ∀ θ : V, ψ c (S.gEnd c θ) = ψ c θ + S.gLen c θ := by
  refine S.time_induction (fun θ ih => ?_)
  by_cases h : S.NF θ
  · rw [S.gEnd_of_NF c h, S.gLen_of_NF c h]
    have ih' : ψ c (S.gEnd c (S.g c θ)) = ψ c (S.g c θ) + S.gLen c (S.g c θ) :=
      ih h (S.gb c θ)
    have h2 : ψ c (S.g c θ) = ψ c θ + 1 -
        (if S.prov θ (S.gb c θ) = c then (Fintype.card C : ℤ) else 0) :=
      hψ.2 θ (S.gb c θ) c h
    rw [if_neg (S.prov_gb c h)] at h2
    rw [ih', h2]
    push_cast
    ring
  · rw [S.gEnd_of_not c h, S.gLen_of_not c h]
    simp

/-! ## Poles (Step 2) -/

/-- A pole: a location and, for each charge, the first step (`true`/`false`: which support). -/
structure Pole (V C : Type*) where
  /-- the location `θ_σ` -/
  loc : V
  /-- the first step of the arm of each charge -/
  fs : C → Bool

instance [DecidableEq V] : DecidableEq (Pole V C) := fun a b =>
  decidable_of_iff (a.loc = b.loc ∧ a.fs = b.fs) (by cases a; cases b; simp)

/-- The first step `f_c(σ)`. -/
def pFirst (σ : Pole V C) (c : C) : V := S.sup σ.loc (σ.fs c)

/-- `end_c(σ)`: the last vertex of the arm of charge `c`. -/
def pEnd (σ : Pole V C) (c : C) : V := S.gEnd c (S.pFirst σ c)

/-- The number of edges of the arm of charge `c`. -/
def pLen (σ : Pole V C) (c : C) : ℕ := S.gLen c (S.pFirst σ c) + 1

/-- The edges of the arm of charge `c`. -/
def pEdges [DecidableEq V] (σ : Pole V C) (c : C) : Finset (Sym2 V) :=
  insert s(σ.loc, S.pFirst σ c) (S.gEdges c (S.pFirst σ c))

/-- The root pole `σ_ρ`: all first steps good. -/
def rootPole (ρ : V) : Pole V C := ⟨ρ, fun c => S.gb c ρ⟩

/-- A pole is valid if it is located at a non-terminal vertex reached from `ρ`. -/
def Valid (ρ : V) (σ : Pole V C) : Prop := S.Reach ρ σ.loc ∧ S.NF σ.loc

theorem pEnd_term (σ : Pole V C) (c : C) : S.Term (S.pFirst σ c) (S.pEnd σ c) :=
  S.gEnd_term c _

theorem pEnd_term_root {ρ : V} {σ : Pole V C} (h : S.Valid ρ σ) (c : C) :
    S.Term ρ (S.pEnd σ c) :=
  S.term_trans h.1 (S.term_of_sup h.2 (S.pEnd_term σ c))

/-- The change of `ψ_c` along an arm: its length, minus `q` if the first edge is bad. -/
theorem pole_psi {ψ : C → V → ℤ} (hψ : S.IsPotential ψ) {σ : Pole V C} (h : S.NF σ.loc)
    (c : C) : ψ c (S.pEnd σ c) = ψ c σ.loc + S.pLen σ c -
      (if S.prov σ.loc (σ.fs c) = c then (Fintype.card C : ℤ) else 0) := by
  unfold pEnd pLen
  rw [S.gEnd_psi hψ c, show ψ c (S.pFirst σ c) = _ from hψ.2 σ.loc (σ.fs c) c h]
  push_cast
  ring

/-! ## Fronts and the splitting (Step 3) -/

section Fronts

variable [DecidableEq V]

/-- Two terminals both lie in `Φ(θ)` for one `θ ∈ W`. -/
def Ov (W : Finset V) (a b : V) : Prop := ∃ θ ∈ W, S.Term θ a ∧ S.Term θ b

/-- The equivalence generated by `Ov W`; its classes on `Φ` are the sets `Φ(𝒦)` of the
components `𝒦` of the front `W`. -/
def Rel (W : Finset V) : V → V → Prop := ReflTransGen (S.Ov W)

/-- `(I_h)`: for every terminal `φ` and charge `c`, exactly one pole has its `c`-arm ending in
the class of `φ`. -/
def Inv (ρ : V) (W : Finset V) (P : Finset (Pole V C)) : Prop :=
  ∀ φ, S.Term ρ φ → ∀ c, ∃! σ, σ ∈ P ∧ S.Rel W (S.pEnd σ c) φ

/-- The front after splitting `θ`: `(W \ {θ}) ∪ {θ⁽¹⁾, θ⁽²⁾}` (fact (a)). -/
def front (W : Finset V) (θ : V) : Finset V :=
  insert (S.sup θ true) (insert (S.sup θ false) (W.erase θ))

theorem rel_symm {W : Finset V} {a b : V} (h : S.Rel W a b) : S.Rel W b a :=
  by
    letI : Std.Symm (S.Ov W) := ⟨fun _ _ ⟨θ, hθ, h1, h2⟩ => ⟨θ, hθ, h2, h1⟩⟩
    exact (ReflTransGen.stdSymm (r := S.Ov W)).symm _ _ h

theorem rel_of_term {W : Finset V} {θ a b : V} (hθ : θ ∈ W) (ha : S.Term θ a)
    (hb : S.Term θ b) : S.Rel W a b :=
  ReflTransGen.single ⟨θ, hθ, ha, hb⟩

theorem mem_front_true (W : Finset V) (θ : V) : S.sup θ true ∈ S.front W θ :=
  Finset.mem_insert_self _ _

theorem mem_front_false (W : Finset V) (θ : V) : S.sup θ false ∈ S.front W θ :=
  Finset.mem_insert_of_mem (Finset.mem_insert_self _ _)

theorem rel_front_mono {W : Finset V} {θ : V} (hθW : θ ∈ W) (hθ : S.NF θ) {a b : V}
    (h : S.Rel (S.front W θ) a b) : S.Rel W a b := by
  refine ReflTransGen.mono (fun x y hxy => ?_) _ _ h
  obtain ⟨θ', hθ', h1, h2⟩ := hxy
  rcases Finset.mem_insert.mp hθ' with rfl | hθ'
  · exact ⟨θ, hθW, S.term_of_sup hθ h1, S.term_of_sup hθ h2⟩
  · rcases Finset.mem_insert.mp hθ' with rfl | hθ'
    · exact ⟨θ, hθW, S.term_of_sup hθ h1, S.term_of_sup hθ h2⟩
    · exact ⟨θ', Finset.mem_of_mem_erase hθ', h1, h2⟩

/-- Fact (d), in the form used: a chain through the old front either survives in the new front,
or both of its ends are joined in the new front to terminals of `Φ(θ)`. -/
theorem rel_split {W : Finset V} {θ : V} {x y : V} (h : S.Rel W x y) :
    S.Rel (S.front W θ) x y ∨
      ((∃ a, S.Term θ a ∧ S.Rel (S.front W θ) x a) ∧
        (∃ b, S.Term θ b ∧ S.Rel (S.front W θ) b y)) := by
  induction h with
  | refl => exact Or.inl ReflTransGen.refl
  | @tail y z _ hyz ih =>
    obtain ⟨θ', hθ', h1, h2⟩ := hyz
    by_cases he : θ' = θ
    · rw [he] at h1 h2
      refine Or.inr ⟨?_, z, h2, ReflTransGen.refl⟩
      rcases ih with h | ⟨ha, -⟩
      · exact ⟨y, h1, h⟩
      · exact ha
    · have hθ'F : θ' ∈ S.front W θ :=
        Finset.mem_insert_of_mem (Finset.mem_insert_of_mem (Finset.mem_erase.mpr ⟨he, hθ'⟩))
      have hyz' : S.Ov (S.front W θ) y z := ⟨θ', hθ'F, h1, h2⟩
      rcases ih with h | ⟨ha, b, hb, hby⟩
      · exact Or.inl (h.tail hyz')
      · exact Or.inr ⟨ha, b, hb, hby.tail hyz'⟩

/-- One splitting step preserves `(I_h)`, adding at most one pole (located at `θ`). -/
theorem step_exists (ρ : V) {W : Finset V} {P : Finset (Pole V C)}
    (hW : ∀ θ ∈ W, S.Reach ρ θ) (hP : ∀ σ ∈ P, S.Valid ρ σ) (hinv : S.Inv ρ W P) {θ : V}
    (hθW : θ ∈ W) (hθ : S.NF θ) :
    ∃ P', P ⊆ P' ∧ (∀ σ ∈ P', S.Valid ρ σ) ∧ S.Inv ρ (S.front W θ) P' := by
  classical
  have hθ₁ := S.mem_front_true W θ
  have hθ₂ := S.mem_front_false W θ
  have mono : ∀ {a b : V}, S.Rel (S.front W θ) a b → S.Rel W a b :=
    fun h => S.rel_front_mono hθW hθ h
  have side : ∀ {a : V}, S.Term θ a → S.Term (S.sup θ true) a ∨ S.Term (S.sup θ false) a :=
    fun h => (S.term_sup_iff hθ).mp h
  by_cases hA : ∃ a b, S.Term (S.sup θ true) a ∧ S.Term (S.sup θ false) b ∧
      S.Rel (S.front W θ) a b
  · -- the class of `θ` does not split: no new pole
    obtain ⟨a₀, b₀, ha₀, hb₀, hab⟩ := hA
    have hjoin : ∀ {a b : V}, S.Term θ a → S.Term θ b → S.Rel (S.front W θ) a b := by
      intro a b ha hb
      rcases side ha with ha | ha <;> rcases side hb with hb | hb
      · exact S.rel_of_term hθ₁ ha hb
      · exact (S.rel_of_term hθ₁ ha ha₀).trans (hab.trans (S.rel_of_term hθ₂ hb₀ hb))
      · exact (S.rel_of_term hθ₂ ha hb₀).trans ((S.rel_symm hab).trans (S.rel_of_term hθ₁ ha₀ hb))
      · exact S.rel_of_term hθ₂ ha hb
    have heq : ∀ {x y : V}, S.Rel W x y → S.Rel (S.front W θ) x y := by
      intro x y h
      rcases S.rel_split h with h | ⟨⟨a, ha, hxa⟩, ⟨b, hb, hby⟩⟩
      · exact h
      · exact hxa.trans ((hjoin ha hb).trans hby)
    refine ⟨P, subset_rfl, hP, fun φ hφ c => ?_⟩
    obtain ⟨σ, ⟨hσ, hrσ⟩, huniq⟩ := hinv φ hφ c
    exact ⟨σ, ⟨hσ, heq hrσ⟩, fun σ' h => huniq σ' ⟨h.1, mono h.2⟩⟩
  · -- the class of `θ` splits in two: add the pole `σ_θ`
    push Not at hA
    obtain ⟨φ₀, hφ₀⟩ := S.exists_term θ
    have hφ₀ρ : S.Term ρ φ₀ := S.term_trans (hW θ hθW) hφ₀
    have hex : ∀ c, ∃ σ, (σ ∈ P ∧ S.Rel W (S.pEnd σ c) φ₀) ∧
        ∀ σ', σ' ∈ P ∧ S.Rel W (S.pEnd σ' c) φ₀ → σ' = σ := fun c => hinv φ₀ hφ₀ρ c
    choose σc hσc huniq using hex
    let fs : C → Bool := fun c =>
      decide (¬ ∃ a, S.Term (S.sup θ true) a ∧ S.Rel (S.front W θ) (S.pEnd (σc c) c) a)
    let σn : Pole V C := ⟨θ, fs⟩
    refine ⟨insert σn P, Finset.subset_insert _ _, ?_, ?_⟩
    · intro σ hσ
      rcases Finset.mem_insert.mp hσ with rfl | hσ
      · exact ⟨hW θ hθW, hθ⟩
      · exact hP σ hσ
    intro φ hφ c
    have hnew : S.Term (S.sup θ (fs c)) (S.pEnd σn c) := S.pEnd_term σn c
    have hnewW : S.Rel W (S.pEnd σn c) φ₀ := S.rel_of_term hθW (S.term_of_sup hθ hnew) hφ₀
    have hxW : S.Rel W (S.pEnd (σc c) c) φ₀ := (hσc c).2
    by_cases hφ0 : S.Rel W φ φ₀
    · -- `φ` lies in the class that splits
      have hsideφ : ∃ a, S.Term θ a ∧ S.Rel (S.front W θ) φ a := by
        rcases S.rel_split hφ0 with h | ⟨h, -⟩
        · exact ⟨φ₀, hφ₀, h⟩
        · exact h
      have hsidex : ∃ a, S.Term θ a ∧ S.Rel (S.front W θ) (S.pEnd (σc c) c) a := by
        rcases S.rel_split hxW with h | ⟨h, -⟩
        · exact ⟨φ₀, hφ₀, h⟩
        · exact h
      have holdW' : ∀ σ', σ' ∈ P → S.Rel (S.front W θ) (S.pEnd σ' c) φ → σ' = σc c :=
        fun σ' h1 h2 => huniq c σ' ⟨h1, (mono h2).trans hφ0⟩
      obtain ⟨a, ha, hφa⟩ := hsideφ
      by_cases hx1 : ∃ a, S.Term (S.sup θ true) a ∧ S.Rel (S.front W θ) (S.pEnd (σc c) c) a
      · have hfs : fs c = false := decide_eq_false (not_not.mpr hx1)
        rw [hfs] at hnew
        obtain ⟨a₁, ha₁, hxa₁⟩ := hx1
        rcases side ha with ha | ha
        · -- `φ` on the side of `θ⁽¹⁾`: the old pole answers
          refine ⟨σc c, ⟨Finset.mem_insert_of_mem (hσc c).1,
            hxa₁.trans ((S.rel_of_term hθ₁ ha₁ ha).trans (S.rel_symm hφa))⟩, ?_⟩
          rintro σ' ⟨hσ', h2⟩
          rcases Finset.mem_insert.mp hσ' with rfl | hσ'
          · exact absurd ((S.rel_symm hφa).trans (S.rel_symm h2)) (hA a _ ha hnew)
          · exact holdW' σ' hσ' h2
        · -- `φ` on the side of `θ⁽²⁾`: the new pole answers
          refine ⟨σn, ⟨Finset.mem_insert_self _ _,
            (S.rel_of_term hθ₂ hnew ha).trans (S.rel_symm hφa)⟩, ?_⟩
          rintro σ' ⟨hσ', h2⟩
          rcases Finset.mem_insert.mp hσ' with rfl | hσ'
          · rfl
          · have := holdW' σ' hσ' h2
            subst this
            exact absurd ((S.rel_symm hxa₁).trans (h2.trans hφa)) (hA a₁ a ha₁ ha)
      · have hfs : fs c = true := decide_eq_true hx1
        rw [hfs] at hnew
        obtain ⟨a', ha', hxa'⟩ := hsidex
        have ha'2 : S.Term (S.sup θ false) a' := by
          rcases side ha' with h | h
          · exact absurd ⟨a', h, hxa'⟩ hx1
          · exact h
        rcases side ha with ha | ha
        · -- `φ` on the side of `θ⁽¹⁾`: the new pole answers
          refine ⟨σn, ⟨Finset.mem_insert_self _ _,
            (S.rel_of_term hθ₁ hnew ha).trans (S.rel_symm hφa)⟩, ?_⟩
          rintro σ' ⟨hσ', h2⟩
          rcases Finset.mem_insert.mp hσ' with rfl | hσ'
          · rfl
          · have := holdW' σ' hσ' h2
            subst this
            exact absurd ⟨a, ha, h2.trans hφa⟩ hx1
        · -- `φ` on the side of `θ⁽²⁾`: the old pole answers
          refine ⟨σc c, ⟨Finset.mem_insert_of_mem (hσc c).1,
            hxa'.trans ((S.rel_of_term hθ₂ ha'2 ha).trans (S.rel_symm hφa))⟩, ?_⟩
          rintro σ' ⟨hσ', h2⟩
          rcases Finset.mem_insert.mp hσ' with rfl | hσ'
          · exact absurd (h2.trans hφa) (hA _ a hnew ha)
          · exact holdW' σ' hσ' h2
    · -- `φ` lies in another class: nothing changes for it
      obtain ⟨σ0, ⟨hσ0, hr0⟩, hu0⟩ := hinv φ hφ c
      refine ⟨σ0, ⟨Finset.mem_insert_of_mem hσ0, ?_⟩, ?_⟩
      · rcases S.rel_split hr0 with h | ⟨-, b, hb, hbφ⟩
        · exact h
        · exact absurd ((S.rel_symm (mono hbφ)).trans (S.rel_of_term hθW hb hφ₀)) hφ0
      · rintro σ' ⟨hσ', h2⟩
        rcases Finset.mem_insert.mp hσ' with rfl | hσ'
        · exact absurd ((S.rel_symm (mono h2)).trans hnewW) hφ0
        · exact hu0 σ' ⟨hσ', mono h2⟩

/-- The measure `Σ_{θ ∈ W} 3^{time θ}`. -/
def meas (W : Finset V) : ℕ := ∑ θ ∈ W, 3 ^ S.time θ

theorem sum_insert_le' (f : V → ℕ) (a : V) (s : Finset V) :
    ∑ x ∈ insert a s, f x ≤ f a + ∑ x ∈ s, f x := by
  by_cases ha : a ∈ s
  · rw [Finset.insert_eq_of_mem ha]
    omega
  · rw [Finset.sum_insert ha]

theorem meas_front_lt {W : Finset V} {θ : V} (hθW : θ ∈ W) (hθ : S.NF θ) :
    S.meas (S.front W θ) < S.meas W := by
  unfold meas front
  have h1 := sum_insert_le' (fun x => 3 ^ S.time x) (S.sup θ true)
    (insert (S.sup θ false) (W.erase θ))
  have h2 := sum_insert_le' (fun x => 3 ^ S.time x) (S.sup θ false) (W.erase θ)
  have h3 := Finset.add_sum_erase W (fun x => 3 ^ S.time x) hθW
  have ht1 := S.time_sup θ true hθ
  have ht2 := S.time_sup θ false hθ
  rw [← ht1] at h3
  have h4 : S.time (S.sup θ false) = S.time (S.sup θ true) := by omega
  rw [h4] at h2
  have hp : 3 ^ (S.time (S.sup θ true) + 1) = 3 * 3 ^ S.time (S.sup θ true) := by ring
  have hpos : 0 < 3 ^ S.time (S.sup θ true) := by positivity
  omega

theorem front_reach {ρ : V} {W : Finset V} (hW : ∀ θ ∈ W, S.Reach ρ θ) {θ : V} (hθW : θ ∈ W)
    (hθ : S.NF θ) : ∀ θ' ∈ S.front W θ, S.Reach ρ θ' := by
  intro θ' h
  rcases Finset.mem_insert.mp h with rfl | h
  · exact (hW θ hθW).trans (S.reach_sup hθ true)
  · rcases Finset.mem_insert.mp h with rfl | h
    · exact (hW θ hθW).trans (S.reach_sup hθ false)
    · exact hW θ' (Finset.mem_of_mem_erase h)

/-- Step 3, iterated: from any front with `(I_h)`, splitting until only terminals remain gives a
set of poles with `fgt:eq-bij`. -/
theorem exists_poles (ρ : V) : ∀ (n : ℕ) (W : Finset V) (P : Finset (Pole V C)), S.meas W = n →
    (∀ θ ∈ W, S.Reach ρ θ) → (∀ σ ∈ P, S.Valid ρ σ) → S.Inv ρ W P →
    ∃ P', P ⊆ P' ∧ (∀ σ ∈ P', S.Valid ρ σ) ∧
      ∀ φ, S.Term ρ φ → ∀ c, ∃! σ, σ ∈ P' ∧ S.pEnd σ c = φ := by
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    intro W P hn hW hP hinv
    by_cases hex : ∃ θ ∈ W, S.NF θ
    · obtain ⟨θ, hθW, hθ⟩ := hex
      obtain ⟨P₁, hP₁, hv₁, hinv₁⟩ := S.step_exists ρ hW hP hinv hθW hθ
      obtain ⟨P', hP', hv', hfin⟩ := ih _ (hn ▸ S.meas_front_lt hθW hθ) (S.front W θ) P₁ rfl
        (S.front_reach hW hθW hθ) hv₁ hinv₁
      exact ⟨P', hP₁.trans hP', hv', hfin⟩
    · push Not at hex
      have hov : ∀ a b, S.Ov W a b → a = b := by
        rintro a b ⟨θ, hθ, ha, hb⟩
        rw [S.eq_of_reach_of_not_NF (hex θ hθ) ha.1, S.eq_of_reach_of_not_NF (hex θ hθ) hb.1]
      have hrel : ∀ {x y : V}, S.Rel W x y → x = y := by
        intro x y h
        induction h with
        | refl => rfl
        | tail _ hyz ih => exact ih.trans (hov _ _ hyz)
      refine ⟨P, subset_rfl, hP, fun φ hφ c => ?_⟩
      obtain ⟨σ, ⟨hσ, hrσ⟩, huniq⟩ := hinv φ hφ c
      exact ⟨σ, ⟨hσ, hrel hrσ⟩, fun σ' h => huniq σ' ⟨h.1, h.2 ▸ ReflTransGen.refl⟩⟩

/-- `fgt:eq-bij`: there is a finite set of valid poles containing the root pole such that, for
every terminal `φ` and every charge `c`, exactly one pole has its arm of charge `c` ending at
`φ`. -/
theorem exists_bij {ρ : V} (hρ : S.NF ρ) :
    ∃ P : Finset (Pole V C), S.rootPole ρ ∈ P ∧ (∀ σ ∈ P, S.Valid ρ σ) ∧
      ∀ φ, S.Term ρ φ → ∀ c, ∃! σ, σ ∈ P ∧ S.pEnd σ c = φ := by
  have hroot : S.Valid ρ (S.rootPole ρ) := ⟨ReflTransGen.refl, hρ⟩
  have hinv : S.Inv ρ {ρ} {S.rootPole ρ} := by
    intro φ hφ c
    refine ⟨S.rootPole ρ, ⟨Finset.mem_singleton_self _, ?_⟩, fun σ h => ?_⟩
    · exact S.rel_of_term (Finset.mem_singleton_self ρ) (S.pEnd_term_root hroot c) hφ
    · exact Finset.mem_singleton.mp h.1
  obtain ⟨P, hP, hv, hbij⟩ := S.exists_poles ρ _ {ρ} {S.rootPole ρ} rfl
    (fun θ h => by rw [Finset.mem_singleton.mp h]; exact ReflTransGen.refl) (fun σ h => by
      rw [Finset.mem_singleton.mp h]; exact hroot) hinv
  exact ⟨P, hP (Finset.mem_singleton_self _), hv, hbij⟩

end Fronts

end SupportSystem

/-! ## Crossing time levels -/

/-- If every edge of `K` joins two consecutive times, then reaching `y` from `x` inside `K`
crosses every level between them, each by its own edge: `time x ≤ time y + |K|`. -/
theorem time_le_of_edgeReach {V : Type*} [DecidableEq V] (time : V → ℕ) (K : Finset (Sym2 V))
    (hK : ∀ e ∈ K, ∃ a b, e = s(a, b) ∧ time b + 1 = time a) {x y : V}
    (h : EdgeCount.Reach K x y) : time x ≤ time y + K.card := by
  have cross : ∀ T, time y ≤ T → T < time x →
      ∃ a b, s(a, b) ∈ K ∧ time a = T + 1 ∧ time b = T := by
    intro T
    induction h with
    | refl => intro h1 h2; omega
    | @tail z w _ hzw ih =>
      intro h1 h2
      by_cases hz : time z ≤ T
      · exact ih hz h2
      · obtain ⟨a, b, hab, hba⟩ := hK _ hzw
        rcases Sym2.eq_iff.mp hab with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
        · exact ⟨z, w, hzw, by omega, by omega⟩
        · omega
  by_cases hxy : time x ≤ time y
  · omega
  haveI : Nonempty V := ⟨x⟩
  have hc : ∀ T ∈ Finset.Ico (time y) (time x), ∃ ab : V × V,
      s(ab.1, ab.2) ∈ K ∧ time ab.1 = T + 1 ∧ time ab.2 = T := by
    intro T hT
    obtain ⟨h1, h2⟩ := Finset.mem_Ico.mp hT
    obtain ⟨a, b, h⟩ := cross T h1 h2
    exact ⟨(a, b), h⟩
  choose! f hf using hc
  have hle := Finset.card_le_card_of_injOn (fun T => s((f T).1, (f T).2))
    (fun T hT => (hf T hT).1) (by
      intro T hT T' hT' heq
      have h1 := hf T hT
      have h2 := hf T' hT'
      rcases Sym2.eq_iff.mp heq with ⟨ha, hb⟩ | ⟨ha, hb⟩
      · have := congrArg time hb
        omega
      · have e1 := congrArg time ha
        have e2 := congrArg time hb
        omega)
  simp only [Nat.card_Ico] at hle
  omega

/-! ## Step 4: the contour -/

namespace SupportSystem

variable {V C : Type*} (S : SupportSystem V C) [DecidableEq C] [Fintype C] [DecidableEq V]

/-- Two poles of `P` are *linked* if an arm of one and an arm of the other end at one terminal
(they share a sink of `H`). -/
def Linked (P : Finset (Pole V C)) (σ σ' : Pole V C) : Prop :=
  σ ∈ P ∧ σ' ∈ P ∧ ∃ c c', S.pEnd σ c = S.pEnd σ' c'

theorem pEdges_card_le (σ : Pole V C) (c : C) : (S.pEdges σ c).card ≤ S.pLen σ c :=
  (Finset.card_insert_le _ _).trans (Nat.add_le_add_right (S.gEdges_card_le c _) 1)

theorem pEdges_reach (σ : Pole V C) (c : C) :
    (∀ e ∈ S.pEdges σ c, ∀ v ∈ e, EdgeCount.Reach (S.pEdges σ c) σ.loc v) ∧
      EdgeCount.Reach (S.pEdges σ c) σ.loc (S.pEnd σ c) := by
  obtain ⟨h1, h2⟩ := S.gEdges_reach c (S.pFirst σ c)
  have hsub : S.gEdges c (S.pFirst σ c) ⊆ S.pEdges σ c := Finset.subset_insert _ _
  have hstep : EdgeCount.Reach (S.pEdges σ c) σ.loc (S.pFirst σ c) :=
    ReflTransGen.single (Finset.mem_insert_self _ _)
  refine ⟨fun e he v hv => ?_, hstep.trans (reach_mono hsub h2)⟩
  rcases Finset.mem_insert.mp he with rfl | he
  · rcases Sym2.mem_iff.mp hv with rfl | rfl
    · exact ReflTransGen.refl
    · exact hstep
  · exact hstep.trans (reach_mono hsub (h1 e he v hv))

theorem pEdges_spec {σ : Pole V C} (h : S.NF σ.loc) (c : C) :
    ∀ e ∈ S.pEdges σ c, ∃ a b, S.Reach σ.loc a ∧ S.NF a ∧ e = s(a, S.sup a b) := by
  intro e he
  rcases Finset.mem_insert.mp he with rfl | he
  · exact ⟨σ.loc, σ.fs c, ReflTransGen.refl, h, rfl⟩
  · obtain ⟨a, b, ha, hna, rfl⟩ := S.gEdges_spec c _ e he
    exact ⟨a, b, (S.reach_sup h _).trans ha, hna, rfl⟩

theorem pEnd_mem (σ : Pole V C) (c : C) : ∃ e ∈ S.pEdges σ c, S.pEnd σ c ∈ e := by
  rcases S.gEnd_mem c (S.pFirst σ c) with h | ⟨e, he, hm⟩
  · refine ⟨_, Finset.mem_insert_self _ _, ?_⟩
    rw [show S.pEnd σ c = S.pFirst σ c from h]
    exact Sym2.mem_mk_right _ _
  · exact ⟨e, Finset.subset_insert _ _ he, hm⟩

theorem pEdges_down {σ : Pole V C} (h : S.NF σ.loc) (c : C) (v : V)
    (hv : ∃ e ∈ S.pEdges σ c, v ∈ e) :
    v = S.pEnd σ c ∨ ∃ w, s(v, w) ∈ S.pEdges σ c ∧ S.time w + 1 = S.time v := by
  have hsub : S.gEdges c (S.pFirst σ c) ⊆ S.pEdges σ c := Finset.subset_insert _ _
  have hg : (v = S.pFirst σ c ∨ ∃ e ∈ S.gEdges c (S.pFirst σ c), v ∈ e) →
      v = S.pEnd σ c ∨ ∃ w, s(v, w) ∈ S.pEdges σ c ∧ S.time w + 1 = S.time v := by
    intro hv'
    rcases S.gEdges_down c _ v hv' with h1 | ⟨h1, h2⟩
    · exact Or.inl h1
    · exact Or.inr ⟨S.g c v, hsub h2, (S.time_g c h1).symm⟩
  obtain ⟨e, he, hve⟩ := hv
  rcases Finset.mem_insert.mp he with rfl | he
  · rcases Sym2.mem_iff.mp hve with rfl | rfl
    · exact Or.inr ⟨_, Finset.mem_insert_self _ _, S.time_sup _ _ h⟩
    · exact hg (Or.inl rfl)
  · exact hg (Or.inr ⟨e, he, hve⟩)

/-- **`lem:contour`, abstract form.** Let `ρ` be non-terminal. There are a finite set `Sig` of
`m` terminals reached from `ρ` and a finite set `K` of support edges (each joining a non-terminal
vertex reached from `ρ` to one of its supports) such that
(i) `K` is connected at `ρ`, and `ρ` and every point of `Sig` are ends of edges of `K`;
(ii) `1 ≤ |K| ≤ q²(m - 1)` (written `|K| + q² ≤ q² m`);
(iii) every vertex of `K` has time at most `time ρ` and at least the time of some point of
`Sig`, and `time ρ ≤ time φ + |K|` for every `φ ∈ Sig`. -/
theorem contour {ψ : C → V → ℤ} (hψ : S.IsPotential ψ) {ρ : V} (hρ : S.NF ρ) :
    ∃ (Sig : Finset V) (K : Finset (Sym2 V)),
      (∀ φ ∈ Sig, S.Term ρ φ) ∧
      (∀ e ∈ K, ∃ a b, S.Reach ρ a ∧ S.NF a ∧ e = s(a, S.sup a b)) ∧
      EdgeCount.ConnectedAt K ρ ∧
      (∃ e ∈ K, ρ ∈ e) ∧ (∀ φ ∈ Sig, ∃ e ∈ K, φ ∈ e) ∧
      1 ≤ K.card ∧ K.card + Fintype.card C ^ 2 ≤ Fintype.card C ^ 2 * Sig.card ∧
      (∀ e ∈ K, ∀ v ∈ e, S.time v ≤ S.time ρ ∧ ∃ φ ∈ Sig, S.time φ ≤ S.time v) ∧
      (∀ φ ∈ Sig, S.time ρ ≤ S.time φ + K.card) := by
  classical
  obtain ⟨P, hrootP, hvalid, hbij⟩ := S.exists_bij hρ
  set c₀ : C := S.prov ρ true with hc₀
  set Pρ := P.filter (fun σ => ReflTransGen (S.Linked P) (S.rootPole ρ) σ) with hPρ
  set Sig := Pρ.image (fun σ => S.pEnd σ c₀) with hSig
  set K := Pρ.biUnion (fun σ => Finset.univ.biUnion (fun c => S.pEdges σ c)) with hK
  have hroot : S.rootPole ρ ∈ Pρ := Finset.mem_filter.mpr ⟨hrootP, ReflTransGen.refl⟩
  have hPρP : ∀ σ ∈ Pρ, σ ∈ P := fun σ h => (Finset.mem_filter.mp h).1
  have hPρC : ∀ σ ∈ Pρ, ReflTransGen (S.Linked P) (S.rootPole ρ) σ :=
    fun σ h => (Finset.mem_filter.mp h).2
  have hNF : ∀ σ ∈ Pρ, S.NF σ.loc := fun σ h => (hvalid σ (hPρP σ h)).2
  have hinj : ∀ c, ∀ σ ∈ P, ∀ σ' ∈ P, S.pEnd σ c = S.pEnd σ' c → σ = σ' := by
    intro c σ hσ σ' hσ' h
    obtain ⟨τ, -, hτ⟩ := hbij _ (S.pEnd_term_root (hvalid σ hσ) c) c
    exact (hτ σ ⟨hσ, rfl⟩).trans (hτ σ' ⟨hσ', h.symm⟩).symm
  have himage : ∀ c, Pρ.image (fun σ => S.pEnd σ c) = Sig := by
    have key : ∀ c c', Pρ.image (fun σ => S.pEnd σ c) ⊆ Pρ.image (fun σ => S.pEnd σ c') := by
      intro c c' φ hφ
      obtain ⟨σ, hσ, rfl⟩ := Finset.mem_image.mp hφ
      obtain ⟨τ, ⟨hτP, hτe⟩, -⟩ := hbij _ (S.pEnd_term_root (hvalid σ (hPρP σ hσ)) c) c'
      refine Finset.mem_image.mpr ⟨τ, Finset.mem_filter.mpr ⟨hτP, ?_⟩, hτe⟩
      exact (hPρC σ hσ).tail ⟨hPρP σ hσ, hτP, c, c', hτe.symm⟩
    intro c
    exact Finset.Subset.antisymm (key c c₀) (key c₀ c)
  have hcard : Sig.card = Pρ.card :=
    Finset.card_image_of_injOn (fun σ hσ σ' hσ' h => hinj c₀ σ (hPρP σ hσ) σ' (hPρP σ' hσ') h)
  have hm1 : 1 ≤ Pρ.card := Finset.card_pos.mpr ⟨_, hroot⟩
  -- the potential count
  have hA : ∑ σ ∈ Pρ, ∑ c, ψ c (S.pEnd σ c) = 0 := by
    rw [Finset.sum_comm]
    calc ∑ c, ∑ σ ∈ Pρ, ψ c (S.pEnd σ c) = ∑ c, ∑ φ ∈ Sig, ψ c φ := by
          refine Finset.sum_congr rfl (fun c _ => ?_)
          rw [← himage c, Finset.sum_image
            (fun σ hσ σ' hσ' h => hinj c σ (hPρP σ hσ) σ' (hPρP σ' hσ') h)]
      _ = ∑ φ ∈ Sig, ∑ c, ψ c φ := Finset.sum_comm
      _ = 0 := Finset.sum_eq_zero (fun φ _ => hψ.1 φ)
  have hB : ∑ σ ∈ Pρ, ∑ c, ψ c σ.loc = 0 := Finset.sum_eq_zero (fun σ _ => hψ.1 σ.loc)
  have hlen : (∑ σ ∈ Pρ, ∑ c, (S.pLen σ c : ℤ)) =
      ∑ σ ∈ Pρ, ∑ c, (if S.prov σ.loc (σ.fs c) = c then (Fintype.card C : ℤ) else 0) := by
    have h1 : ∀ σ ∈ Pρ, ∀ c, (S.pLen σ c : ℤ) = ψ c (S.pEnd σ c) - ψ c σ.loc +
        (if S.prov σ.loc (σ.fs c) = c then (Fintype.card C : ℤ) else 0) := by
      intro σ hσ c
      rw [S.pole_psi hψ (hNF σ hσ) c]
      ring
    rw [Finset.sum_congr rfl (fun σ hσ => Finset.sum_congr rfl (fun c _ => h1 σ hσ c))]
    simp only [Finset.sum_add_distrib, Finset.sum_sub_distrib, hA, hB]
    ring
  have hbad : ∑ σ ∈ Pρ, ∑ c, (if S.prov σ.loc (σ.fs c) = c then (Fintype.card C : ℤ) else 0) ≤
      (Fintype.card C : ℤ) * Fintype.card C * ((Pρ.card - 1 : ℕ) : ℤ) := by
    rw [← Finset.add_sum_erase _ _ hroot]
    have hr : ∑ c, (if S.prov (S.rootPole ρ).loc ((S.rootPole ρ).fs c) = c
        then (Fintype.card C : ℤ) else 0) = 0 :=
      Finset.sum_eq_zero (fun c _ => if_neg (S.prov_gb c hρ))
    rw [hr, zero_add, ← Finset.card_erase_of_mem hroot]
    calc _ ≤ ∑ σ ∈ Pρ.erase (S.rootPole ρ), (Fintype.card C : ℤ) * Fintype.card C :=
          Finset.sum_le_sum (fun σ _ => ?_)
      _ = _ := by rw [Finset.sum_const, nsmul_eq_mul]; ring
    calc ∑ c, (if S.prov σ.loc (σ.fs c) = c then (Fintype.card C : ℤ) else 0) ≤
          ∑ _c : C, (Fintype.card C : ℤ) :=
          Finset.sum_le_sum (fun c _ => by split_ifs <;> simp)
      _ = _ := by rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
  have hKle : K.card ≤ ∑ σ ∈ Pρ, ∑ c, S.pLen σ c :=
    Finset.card_biUnion_le.trans (Finset.sum_le_sum (fun σ _ =>
      Finset.card_biUnion_le.trans (Finset.sum_le_sum (fun c _ => S.pEdges_card_le σ c))))
  have hKbound : K.card + Fintype.card C ^ 2 ≤ Fintype.card C ^ 2 * Sig.card := by
    rw [hcard]
    have h1 : (K.card : ℤ) ≤ ∑ σ ∈ Pρ, ∑ c, (S.pLen σ c : ℤ) := by
      have h0 := (Nat.cast_le (α := ℤ)).mpr hKle
      simp only [Nat.cast_sum] at h0
      exact h0
    have h2 := h1.trans (hlen.le.trans hbad)
    have h3 : ((Pρ.card - 1 : ℕ) : ℤ) = (Pρ.card : ℤ) - 1 := by omega
    rw [h3] at h2
    zify
    nlinarith [h2]
  -- membership in `K`
  have hmemK : ∀ σ ∈ Pρ, ∀ c, S.pEdges σ c ⊆ K := fun σ hσ c e he =>
    Finset.mem_biUnion.mpr ⟨σ, hσ, Finset.mem_biUnion.mpr ⟨c, Finset.mem_univ _, he⟩⟩
  have hKmem : ∀ e ∈ K, ∃ σ ∈ Pρ, ∃ c, e ∈ S.pEdges σ c := by
    intro e he
    obtain ⟨σ, hσ, he⟩ := Finset.mem_biUnion.mp he
    obtain ⟨c, -, he⟩ := Finset.mem_biUnion.mp he
    exact ⟨σ, hσ, c, he⟩
  have hfirst : s(ρ, S.pFirst (S.rootPole ρ) c₀) ∈ K :=
    hmemK _ hroot c₀ (Finset.mem_insert_self _ _)
  -- (i) connectivity
  have hlocReach : ∀ σ, ReflTransGen (S.Linked P) (S.rootPole ρ) σ →
      EdgeCount.Reach K ρ σ.loc := by
    intro σ h
    induction h with
    | refl => exact ReflTransGen.refl
    | @tail b σ' hrb hbσ ih =>
      obtain ⟨hbP, hσ'P, c, c', hend⟩ := hbσ
      have hbρ : b ∈ Pρ := Finset.mem_filter.mpr ⟨hbP, hrb⟩
      have hσ'ρ : σ' ∈ Pρ :=
        Finset.mem_filter.mpr ⟨hσ'P, hrb.tail ⟨hbP, hσ'P, c, c', hend⟩⟩
      have h1 := reach_mono (hmemK b hbρ c) (S.pEdges_reach b c).2
      have h2 := reach_symm (reach_mono (hmemK σ' hσ'ρ c') (S.pEdges_reach σ' c').2)
      rw [hend] at h1
      exact ih.trans (h1.trans h2)
  have hconn : EdgeCount.ConnectedAt K ρ := by
    intro e he v hv
    obtain ⟨σ, hσ, c, he⟩ := hKmem e he
    exact (hlocReach σ (hPρC σ hσ)).trans
      (reach_mono (hmemK σ hσ c) ((S.pEdges_reach σ c).1 e he v hv))
  have hspec : ∀ e ∈ K, ∃ a b, S.Reach ρ a ∧ S.NF a ∧ e = s(a, S.sup a b) := by
    intro e he
    obtain ⟨σ, hσ, c, he⟩ := hKmem e he
    obtain ⟨a, b, ha, hna, rfl⟩ := S.pEdges_spec (hNF σ hσ) c e he
    exact ⟨a, b, (hvalid σ (hPρP σ hσ)).1.trans ha, hna, rfl⟩
  have hSigK : ∀ φ ∈ Sig, ∃ e ∈ K, φ ∈ e := by
    intro φ hφ
    obtain ⟨σ, hσ, rfl⟩ := Finset.mem_image.mp hφ
    obtain ⟨e, he, hm⟩ := S.pEnd_mem σ c₀
    exact ⟨e, hmemK σ hσ c₀ he, hm⟩
  have hSigTerm : ∀ φ ∈ Sig, S.Term ρ φ := by
    intro φ hφ
    obtain ⟨σ, hσ, rfl⟩ := Finset.mem_image.mp hφ
    exact S.pEnd_term_root (hvalid σ (hPρP σ hσ)) c₀
  -- (iii) times
  have htimeK : ∀ e ∈ K, ∀ v ∈ e, S.time v ≤ S.time ρ := by
    intro e he v hv
    obtain ⟨a, b, ha, hna, rfl⟩ := hspec e he
    rcases Sym2.mem_iff.mp hv with rfl | rfl
    · exact S.time_le_of_reach ha
    · exact S.time_le_of_reach (ha.trans (S.reach_sup hna b))
  have hdown : ∀ v, (∃ e ∈ K, v ∈ e) →
      v ∈ Sig ∨ ∃ w, (∃ e ∈ K, w ∈ e) ∧ S.time w + 1 = S.time v := by
    rintro v ⟨e, he, hv⟩
    obtain ⟨σ, hσ, c, he⟩ := hKmem e he
    rcases S.pEdges_down (hNF σ hσ) c v ⟨e, he, hv⟩ with h | ⟨w, hw, ht⟩
    · left
      rw [← himage c, h]
      exact Finset.mem_image_of_mem _ hσ
    · exact Or.inr ⟨w, ⟨_, hmemK σ hσ c hw, Sym2.mem_mk_right _ _⟩, ht⟩
  have hmin : ∀ n v, S.time v = n → (∃ e ∈ K, v ∈ e) → ∃ φ ∈ Sig, S.time φ ≤ S.time v := by
    intro n
    induction n using Nat.strong_induction_on with
    | _ n ih =>
      intro v hvn hv
      rcases hdown v hv with h | ⟨w, hw, ht⟩
      · exact ⟨v, h, le_rfl⟩
      · obtain ⟨φ, hφ, hle⟩ := ih (S.time w) (by omega) w rfl hw
        exact ⟨φ, hφ, by omega⟩
  have hKt : ∀ e ∈ K, ∃ a b, e = s(a, b) ∧ S.time b + 1 = S.time a := by
    intro e he
    obtain ⟨a, b, -, hna, rfl⟩ := hspec e he
    exact ⟨a, S.sup a b, rfl, S.time_sup a b hna⟩
  have hcross : ∀ φ ∈ Sig, S.time ρ ≤ S.time φ + K.card := by
    intro φ hφ
    obtain ⟨e, he, hm⟩ := hSigK φ hφ
    exact time_le_of_edgeReach S.time K hKt (hconn e he φ hm)
  exact ⟨Sig, K, hSigTerm, hspec, hconn, ⟨_, hfirst, Sym2.mem_mk_left _ _⟩, hSigK,
    Finset.card_pos.mpr ⟨_, hfirst⟩, hKbound,
    fun e he v hv => ⟨htimeK e he v hv, hmin _ v rfl ⟨e, he, hv⟩⟩, hcross⟩

end SupportSystem

end FNE.Contour
